class Solution {
    public int[] sortedSquares(int[] nums) {
        int n=nums.length;
      int i=0;
      int j=n-1;
      int ans[]=new int[n];
      for(int r=n-1;r>=0;r--){
        int leftsq=nums[i]*nums[i];
        int rightsq=nums[j]*nums[j];
        if(leftsq>rightsq){
            ans[r]=leftsq;
            i++;
        }
        else{
            ans[r]=rightsq;
            j--;
        }
      }  
      return ans;
    }
}
