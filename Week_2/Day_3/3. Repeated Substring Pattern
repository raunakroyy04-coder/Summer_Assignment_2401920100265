class Solution {
    public boolean repeatedSubstringPattern(String s) {
        int n = s.length();
        for (int len = 1; len <= n / 2; len++) {
            if (n % len == 0) {
                String sub = s.substring(0, len);

                int i = 0;
                int j = 0; 

                while (i < n) {
                    if (s.charAt(i) != sub.charAt(j)) {
                        break; 
                    }
                    i++;
                    j = (j + 1) % len; 
                }

                if (i == n) return true;
            }
        }
        return false;
    }
}
