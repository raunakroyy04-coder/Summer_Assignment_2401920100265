class Solution {
    public boolean isAnagram(String s, String t) {
    HashMap<Character,Integer> mp=new HashMap<>();
    for(int i=0;i<s.length();i++){
        char ch=s.charAt(i);
        mp.put(ch,mp.getOrDefault(ch,0)+1);
    }
    for(int i=0;i<t.length();i++){
        char ch=t.charAt(i);
        if(mp.get(ch)!=null){
            if(mp.get(ch)==1){
                mp.remove(ch);
            }
            else{
                mp.put(ch,mp.get(ch)-1);
            }
        }else{
            return false;
        }
    }
    return mp.isEmpty();
    }
}
