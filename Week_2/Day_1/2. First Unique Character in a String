class Solution {
    public int firstUniqChar(String s) {

        HashSet<Character> seen = new HashSet<>();
        HashSet<Character> duplicate = new HashSet<>();

        
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);

            if (duplicate.contains(c)) {
                continue;
            }

            if (seen.contains(c)) {
                seen.remove(c);
                duplicate.add(c);
            } else {
                seen.add(c);
            }
        }

        
        for (int i = 0; i < s.length(); i++) {
            if (seen.contains(s.charAt(i))) {
                return i;
            }
        }

        return -1;
    }
}
